{
  "_meta": {
    "title": "Phase 0I — Test B: RGB + ControlNet Depth",
    "description": "SD 1.5 img2img with true ControlNet Depth conditioning. Tests whether depth improves geometry preservation."
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "v1-5-pruned-emaonly.safetensors" },
    "_meta": { "title": "Load Checkpoint (SD 1.5)" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "photorealistic architectural interior visualization, modern living room, preserve exact wall geometry, wall openings, ceiling structure, cabinetry, furniture placement, improve material realism, realistic lighting, sharp details, high quality render",
      "clip": ["1", 1]
    },
    "_meta": { "title": "Positive Prompt" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "cartoon, illustration, painting, sketch, low quality, blurry, distorted geometry, missing walls, extra furniture, redesigned space, fish eye, panorama distortion",
      "clip": ["1", 1]
    },
    "_meta": { "title": "Negative Prompt" }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": { "image": "phase0i_rgb.png" },
    "_meta": { "title": "Load RGB Input" }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": { "image": "phase0i_depth.png" },
    "_meta": { "title": "Load Depth Map" }
  },
  "6": {
    "class_type": "ControlNetLoader",
    "inputs": { "control_net_name": "control_v11f1p_sd15_depth.safetensors" },
    "_meta": { "title": "Load ControlNet Depth" }
  },
  "7": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["2", 0],
      "negative": ["3", 0],
      "control_net": ["6", 0],
      "image": ["5", 0],
      "strength": 0.8,
      "start_percent": 0.0,
      "end_percent": 1.0
    },
    "_meta": { "title": "Apply ControlNet Depth" }
  },
  "8": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": ["4", 0],
      "vae": ["1", 2]
    },
    "_meta": { "title": "Encode RGB to Latent" }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["7", 0],
      "negative": ["7", 1],
      "latent_image": ["8", 0],
      "seed": 42,
      "steps": 20,
      "cfg": 7.0,
      "sampler_name": "euler_ancestral",
      "scheduler": "karras",
      "denoise": 0.65
    },
    "_meta": { "title": "KSampler (img2img + ControlNet)" }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["9", 0],
      "vae": ["1", 2]
    },
    "_meta": { "title": "Decode Latent" }
  },
  "11": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["10", 0],
      "filename_prefix": "phase0i_B"
    },
    "_meta": { "title": "Save Output" }
  }
}
